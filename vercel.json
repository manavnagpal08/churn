{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "main:app",
      "framework": "fastapi",
      "functions": {
        "main.py": {
          "maxDuration": 60,
          "excludeFiles": "{__pycache__/**,**/*.pyc,requirements-dev.txt,artifacts/dt_model_*.joblib,artifacts/training_progress.json}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
